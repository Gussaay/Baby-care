{
  "name": "baby-care",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Baby care - play organiser for families (React web + Capacitor mobile), English and Arabic",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test src/lib/*.test.js",
